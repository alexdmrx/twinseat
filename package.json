{
  "name": "twinseat",
  "displayName": "Twinseat",
  "description": "Two Claude Code accounts side by side in VS Code: one account per window, the account follows the project, both accounts' usage in one panel. macOS.",
  "version": "0.3.0",
  "preview": true,
  "publisher": "alexdmrx",
  "author": "Alexis Demarecaux",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexdmrx/twinseat.git"
  },
  "bugs": {
    "url": "https://github.com/alexdmrx/twinseat/issues"
  },
  "homepage": "https://github.com/alexdmrx/twinseat",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "accounts",
    "multi-account",
    "work",
    "personal",
    "usage"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "*"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\" && sh tests/lanceur.test.sh",
    "package": "npm run compile && npx --yes @vscode/vsce@3 package --allow-star-activation -o twinseat.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.94.0",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeComptes",
          "title": "%viewsContainer.title%",
          "icon": "resources/icone.svg"
        }
      ]
    },
    "views": {
      "claudeComptes": [
        {
          "id": "claudeComptes.panneau",
          "name": "%view.panneau.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeComptes.choisirCompte",
        "title": "%command.choisirCompte.title%"
      },
      {
        "command": "claudeComptes.actualiser",
        "title": "%command.actualiser.title%"
      },
      {
        "command": "claudeComptes.activer",
        "title": "%command.activer.title%"
      },
      {
        "command": "claudeComptes.desactiver",
        "title": "%command.desactiver.title%"
      },
      {
        "command": "claudeComptes.seConnecter",
        "title": "%command.seConnecter.title%"
      },
      {
        "command": "claudeComptes.ajouterAlias",
        "title": "%command.ajouterAlias.title%"
      },
      {
        "command": "claudeComptes.reprendre",
        "title": "%command.reprendre.title%"
      },
      {
        "command": "claudeComptes.reprendreRelais",
        "title": "%command.reprendreRelais.title%"
      },
      {
        "command": "claudeComptes.bulleA",
        "title": "%command.bulleA.title%",
        "icon": {
          "light": "resources/bulle-A-light.svg",
          "dark": "resources/bulle-A-dark.svg"
        }
      },
      {
        "command": "claudeComptes.bulleB",
        "title": "%command.bulleB.title%",
        "icon": {
          "light": "resources/bulle-B-light.svg",
          "dark": "resources/bulle-B-dark.svg"
        }
      },
      {
        "command": "claudeComptes.bulleInconnu",
        "title": "%command.bulleInconnu.title%",
        "icon": {
          "light": "resources/bulle-inconnu-light.svg",
          "dark": "resources/bulle-inconnu-dark.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeComptes.reprendre",
          "when": "false"
        },
        {
          "command": "claudeComptes.reprendreRelais",
          "when": "false"
        },
        {
          "command": "claudeComptes.bulleA",
          "when": "false"
        },
        {
          "command": "claudeComptes.bulleB",
          "when": "false"
        },
        {
          "command": "claudeComptes.bulleInconnu",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "claudeComptes.bulleA",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel' && claudeComptes.ongletCompte == 'A'",
          "group": "navigation"
        },
        {
          "command": "claudeComptes.bulleB",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel' && claudeComptes.ongletCompte == 'B'",
          "group": "navigation"
        },
        {
          "command": "claudeComptes.bulleInconnu",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel' && claudeComptes.ongletCompte == '?'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "claudeComptes.bulleA",
          "when": "view == claudeVSCodeSidebarSecondary && claudeComptes.compteFenetre == 'A'",
          "group": "navigation"
        },
        {
          "command": "claudeComptes.bulleB",
          "when": "view == claudeVSCodeSidebarSecondary && claudeComptes.compteFenetre == 'B'",
          "group": "navigation"
        },
        {
          "command": "claudeComptes.bulleA",
          "when": "view == claudeVSCodeSidebar && claudeComptes.compteFenetre == 'A'",
          "group": "navigation"
        },
        {
          "command": "claudeComptes.bulleB",
          "when": "view == claudeVSCodeSidebar && claudeComptes.compteFenetre == 'B'",
          "group": "navigation"
        }
      ]
    }
  }
}
